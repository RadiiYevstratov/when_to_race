# Copy to .env.local for development. Every value here is required except the
# last one.

# The web app never writes the schedule - the scrapers do that. The one thing
# it does write is the contact form's own table, so a role for this app needs
# SELECT everywhere plus INSERT on contact_messages. A strictly read-only role
# serves every page correctly and then fails on the contact form alone.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Basic auth for /admin/health.
#
# ADMIN_PASSWORD must be at least 12 characters and must not appear anywhere in
# DATABASE_URL - middleware.ts refuses to serve /admin otherwise, because
# sharing one secret means guessing the weaker surface hands over the stronger.
ADMIN_USER=admin
ADMIN_PASSWORD=generate-a-long-random-value

# The public origin. Used for canonical URLs, Open Graph, the sitemap, and the
# absolute webcal:// links on /subscribe. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. The token from Google Search Console's HTML-tag verification; the
# meta tag is simply omitted when this is unset. Not needed if the domain was
# verified by DNS instead.
GOOGLE_SITE_VERIFICATION=

# Optional, and off until both are set. The contact form stores every message
# either way and /admin/messages lists them; this only saves having to look.
#
#   RESEND_API_KEY  an API key from resend.com
#   CONTACT_TO      where the notification is sent
#   CONTACT_FROM    optional. Must be on a domain verified with the provider;
#                   defaults to Resend's shared sending domain, which needs no
#                   verification and is fine for a notification to yourself.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
